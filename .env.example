# Copy the file matching your target environment:
#   cp .env.development.example .env      # local dev (default)
#   cp .env.production.example .env       # production builds only
#
# Or set APP_ENV when running setup:
#   APP_ENV=development bash scripts/setup-env.sh
#   APP_ENV=production  bash scripts/setup-env.sh

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
EXPO_PUBLIC_POWERSYNC_URL=https://your-instance.powersync.journeyapps.com
