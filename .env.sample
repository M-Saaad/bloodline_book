# =============================================================================
# Bloodline Book — Cloud Agent environment file
# =============================================================================
#
# HOW TO USE (Cursor Cloud Agent):
#   1. Copy this file and fill in your bloodline-book-dev values from Supabase:
#        Dashboard → Project Settings → API
#   2. Save as `.env.local` in the repo root (or upload via Agent environment).
#   3. Confirm the URL project ref matches your dev project (see note below).
#   4. Tell the agent: "Secrets are set" or "I uploaded .env.local"
#
# SECURITY:
#   - Use ONLY the bloodline-book-dev project — never the live farm database.
#   - Do not commit .env.local to git (already in .gitignore).
#   - service_role bypasses RLS — keep it server-side only.
#
# =============================================================================

# --- Required (app + migrations) ---

# Project URL from Supabase → Settings → API → Project URL
# Example: https://abcdefghijklmnop.supabase.co
# (The slug is your project ref — it may or may not literally be "bloodline-book-dev")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# anon / public key — safe for browser (still don't commit to public repos)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PASTE_ANON_KEY_HERE

# service_role key — server only; needed for seeds, writes, migrations via scripts
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PASTE_SERVICE_ROLE_KEY_HERE

# Cloud Agent secret name (same URI as DATABASE_URL). Password `@` is encoded by the migrate helper.
# BLOODLINEBOOK_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- Optional (only if you run direct Postgres scripts) ---

# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# POSTGRES_HOST=db.YOUR_PROJECT_REF.supabase.co
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_database_password
# POSTGRES_DATABASE=postgres
# POSTGRES_PORT=5432

# --- Optional (guest user bootstrap: npm run create:guest) ---

# GUEST_EMAIL=demo@example.com
# GUEST_PASSWORD=change-me-in-production
