{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "DATABASE_TARGET": "development",
        "EXPO_PUBLIC_DATABASE_TARGET": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "DATABASE_TARGET": "development",
        "EXPO_PUBLIC_DATABASE_TARGET": "development"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "DATABASE_TARGET": "production",
        "EXPO_PUBLIC_DATABASE_TARGET": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
